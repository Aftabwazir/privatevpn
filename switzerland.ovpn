# Switzerland - generated OpenVPN client config
client
dev tun
proto udp
remote vpn266305021.v4.softether.net 1194
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
cipher AES-128-CBC
auth SHA1
auth-user-pass auth.txt
verb 3
<ca>
-----BEGIN CERTIFICATE-----
# TODO: paste your inline CA certificate here (or put it in ca.crt and re-run).
-----END CERTIFICATE-----
</ca>
